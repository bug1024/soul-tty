# Soul TTY 配置文件模板：复制为 `.env` 后填入实际值。
# `.env` 已被 `.gitignore` 排除，请勿提交密钥或个人 URL。
#
# 两个 LLM 端点都按 OpenAI Chat Completions 协议工作，不附带任何专属 header。
# 协议一致的好处：你既可以全部指向同一个服务，也可以把短请求分流到小模型，
# 让"主对话的算力"和"辅助请求的算力"互不抢资源。

# --- 主对话 LLM -----------------------------------------------------------
# 用于 Chat 的流式回答；多轮上下文、热更新 system prompt、切句播放等都在这里。
LLM_URL=http://127.0.0.1:8180
# 留空则通过 /v1/models 自动选择第一个可用模型；想固定就写具体 id。
# LLM_MODEL=auto

# --- 辅助 LLM -------------------------------------------------------------
# 一次性短请求：启动欢迎语、换装动态台词、长时间空闲的陪伴短句、
# 关系评估、情绪分类。所有请求都不进入正式对话历史。
# 留空时复用主 LLM 的 URL 与 model。
# AUX_LLM_URL=http://127.0.0.1:8181
# AUX_LLM_MODEL=auto

# --- 可选特性开关 ---------------------------------------------------------
# 异步声音感知（SenseVoiceSmall），默认关闭，需额外下载 ~228MB 模型。
# VOICE_STATE_ENABLED=1
# 关系评估子开关；关闭后评估不落库，Memory/Emotion 不受影响。
# BOND_ENABLED=0
# 会话记忆抽取与按需召回。
# MEMORY_ENABLED=1

# --- 全双工语音交互（commits 01-14） ----------------------------------
# DUPLEX_ENABLED=0                   # 总开关：1=真双工（partial 流 + 取消），0=默认半双工
# DUPLEX_ECHO_SIMILARITY=0.72        # partial 文本与 agent 已播放文本的回声相似度阈值
# AUDIO_IO_BACKEND=portaudio         # 音频 I/O 后端：portaudio | macos_voice
# TTS_PLAYBACK_GAIN=1.0              # TTS 输出增益（>0；1.0 = 原样）
# BARGE_IN_ENABLED=0                 # 旧名兼容，等价于 DUPLEX_ENABLED=1
# BARGE_IN_ECHO_SIMILARITY=0.72      # 旧路径回声阈值
# BACKCHANNEL_ENABLED=1              # agent 说话时识别"嗯/好的"等短肯定词,不打断,只记录
