# Soul TTY 正式对话使用的 Memory Proxy Hermes 配置。
# 复制为 .env 后填写；.env 已被 .gitignore 排除，请勿提交密钥。
LLM_PROXY_URL=http://127.0.0.1:8096/hermes/default
LLM_API_KEY=sk-mem-your-user-key
LLM_TEAM_ID=your-team-id
LLM_AGENT_ID=your-agent-id

# 通常不要设置：留空时 Soul TTY 每次启动都会生成新的会话 ID。
# LLM_CONVERSATION_ID=soul-tty-resume-an-existing-session

# 欢迎语、空闲情绪、换装台词和关系评估保持直连，不写入主会话记忆。
LLM_URL=http://127.0.0.1:8180
