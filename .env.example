# Soul TTY 配置文件模板：复制为 `.env` 后填入实际值。
# `.env` 已被 `.gitignore` 排除，请勿提交密钥或个人 URL。
#
# 两个 LLM 端点都按 OpenAI Chat Completions 协议工作，不附带任何专属 header。
# 协议一致的好处：你既可以全部指向同一个服务，也可以把短请求分流到小模型，
# 让"主对话的算力"和"辅助请求的算力"互不抢资源。

# --- 主对话 LLM -----------------------------------------------------------
# 用于 Chat 的流式回答；多轮上下文、热更新 system prompt、切句播放等都在这里。
LLM_URL=http://127.0.0.1:8180
# 留空则通过 /v1/models 自动选择第一个可用模型；想固定就写具体 id。
# LLM_MODEL=auto

# --- 辅助 LLM -------------------------------------------------------------
# 一次性短请求：启动欢迎语、换装动态台词、长时间空闲的陪伴短句、
# 关系评估、情绪分类。所有请求都不进入正式对话历史。
# 留空时复用主 LLM 的 URL 与 model。
# AUX_LLM_URL=http://127.0.0.1:8181
# AUX_LLM_MODEL=auto

# --- 可选特性开关 ---------------------------------------------------------
# 异步声音感知（SenseVoiceSmall），默认关闭，需额外下载 ~228MB 模型。
# VOICE_STATE_ENABLED=1
# 关系评估子开关；关闭后评估不落库，Memory/Emotion 不受影响。
# BOND_ENABLED=0
# 会话记忆抽取与按需召回。
# MEMORY_ENABLED=1

# --- Agency / 主体性 -------------------------------------------------------
# 本地 ResponsePolicy，不增加 LLM 往返；状态异步写入 state/agency/。
# AGENCY_ENABLED=1
# AGENCY_SILENCE_RATE=0.10            # 仅低 Need + 低风险输入可触发
# AGENCY_CHANGE_TOPIC_RATE=0.08       # 仅存在 unresolved thought 时可触发
# AGENCY_ASK_RATE=0.12                # 短陈述偶尔以自然追问回应
# AGENCY_MIN_TURNS_BEFORE_SILENCE=6   # 会话早期禁止主动沉默
# AGENCY_STATE_PATH=~/.local/state/soul-tty/agency/serena.json

# --- 结构化运行日志 -------------------------------------------------------
# 默认：~/.local/state/soul-tty/logs/soul-tty.jsonl（10MB × 5 轮转）。
# 每条包含 session_id / turn_id，可定位 ASR、Recall、LLM、TTS 各节点耗时。
# SOUL_TTY_LOG_ENABLED=1
# SOUL_TTY_LOG_LEVEL=INFO
# SOUL_TTY_LOG_FILE=~/.local/state/soul-tty/logs/soul-tty.jsonl
# SOUL_TTY_LOG_MAX_BYTES=10485760
# SOUL_TTY_LOG_BACKUP_COUNT=5

# --- 全双工语音交互（commits 01-14） ----------------------------------
# DUPLEX_ENABLED=0                   # 总开关：1=真双工（partial 流 + 取消），0=默认半双工
# DUPLEX_ECHO_SIMILARITY=0.72        # partial 文本与 agent 已播放文本的回声相似度阈值
# DUPLEX_ECHO_GRACE_MS=1800          # 播放结束后保留回声参考的时间（含 ASR endpoint 延迟）
# DUPLEX_PARTIAL_MIN_CHARS=3         # 非明确制止词达到多少字后才允许 partial 打断
# DUPLEX_PARTIAL_CONFIRMATIONS=2     # 自然插话需连续 partial 确认次数；制止词不等待
# DUPLEX_NATURAL_INTERRUPT_ENABLED=0 # 0=仅明确制止词可打断；1=实验性自然插话
# DUPLEX_STRONG_INTERRUPT_RMS=0.030   # 制止词识别失败时，高能近端语音 FINAL 兜底
# DUPLEX_STRONG_INTERRUPT_MIN_CHARS=3 # 声学兜底至少需要的识别字符数
# DUPLEX_PLAYBACK_GATE_ENABLED=1     # 播放时在 ASR 前过滤低能量 AEC 残差
# DUPLEX_PLAYBACK_GATE_PEAK=0.015    # 近端声音开门峰值（兼顾较轻的人声）
# DUPLEX_PLAYBACK_GATE_HOLD_MS=900   # 开门后保持时间，避免真人语音被切碎
# DUPLEX_PLAYBACK_GATE_CONFIRM_FRAMES=8  # 连续约 240ms 才确认，过滤短促回声残差
# DUPLEX_PLAYBACK_GATE_TAIL_MS=1500  # 覆盖 TTS 分块空隙、播放尾声及房间混响
# AUDIO_IO_BACKEND=portaudio         # 音频 I/O 后端：portaudio | macos_voice
# SOUL_TTY_AUDIO_DEBUG=0             # TTY 下默认不转发 helper stderr，避免破坏 Rich/Kitty 画布
# TTS_PLAYBACK_GAIN=1.0              # TTS 输出增益（>0；1.0 = 原样）
# TTS_WHOLE_ANSWER=0                 # 0=语义段流水线（推荐）；1=完整回答后再播报
# MLX_TTS_AUDIO_PADDING_S=2.5        # 慢语气的单段生成余量，降低句尾硬截断概率
# MLX_TTS_EARLY_EOS_RETRIES=1        # 句子音频明显过短时丢弃并重试一次
# MLX_TTS_EARLY_EOS_S_PER_CHAR=0.07  # 提前 EOS 判定的最低秒数/可朗读字符
# TTS_SEMANTIC_FIRST_MIN_CHARS=8     # 首段最少可朗读字符，避免只播机械语气词
# TTS_SEMANTIC_MIN_CHARS=12          # 后续语义段最少可朗读字符
# TTS_SEMANTIC_TARGET_CHARS=28       # 长句优先在此长度附近的逗号处提交
# TTS_SEMANTIC_MAX_CHARS=56          # 无标点异常长句的兜底上限
# TTS_SEMANTIC_MAX_WAIT_MS=650       # 已有自然短语边界时的最长缓冲等待
# BARGE_IN_ENABLED=0                 # 旧名兼容，等价于 DUPLEX_ENABLED=1
# BARGE_IN_ECHO_SIMILARITY=0.72      # 旧路径回声阈值
# BACKCHANNEL_ENABLED=1              # agent 说话时识别"嗯/好的"等短肯定词,不打断,只记录
